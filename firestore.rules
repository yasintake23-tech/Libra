rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isRootAdmin() { return request.auth != null && request.auth.uid == "ZBkz2js9plg07zrny2PzLW80X3i2"; }
    function hasAdminPermission(permission) { return isRootAdmin() || (request.auth != null && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.permissions[permission] == true); }

    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid;

      // First-time profile completion is a one-time transition from the
      // auth-created placeholder profile. It needs to be able to set the
      // username/display name and mark profileCompleted=true without being
      // subject to the normal 180-day/30-day edit limits.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && resource.data.profileCompleted == false
        && request.resource.data.profileCompleted == true
        && request.resource.data.username is string
        && request.resource.data.username.matches("^[a-z0-9._]{3,20}$")
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "username",
          "bio",
          "profileImageUrl",
          "email",
          "profileCompleted",
          "updatedAt"
        ]);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "username",
          "bio",
          "profileImageUrl",
          "email",
          "updatedAt",
          "usernameLastChangedAt",
          "displayNameChangeWindowStart",
          "displayNameChangesInWindow"
        ])
        && (
          request.resource.data.username == resource.data.username
          || (
            request.resource.data.username is string
            && request.resource.data.username.matches("^[a-z0-9._]{3,20}$")
            && request.resource.data.usernameLastChangedAt is timestamp
            && request.resource.data.usernameLastChangedAt == request.time
            && (
              !resource.data.keys().hasAny(["usernameLastChangedAt"])
              || resource.data.usernameLastChangedAt + duration.value(180, "d") <= request.time
            )
          )
        )
        && (
          request.resource.data.displayName == resource.data.displayName
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2
            && request.resource.data.displayName.size() <= 40
            && request.resource.data.displayNameChangeWindowStart is timestamp
            && request.resource.data.displayNameChangesInWindow is int
            && request.resource.data.displayNameChangeWindowStart == request.time
            && request.resource.data.displayNameChangesInWindow == 1
              && (
                !resource.data.keys().hasAny(["displayNameChangeWindowStart"])
                || request.time >= resource.data.displayNameChangeWindowStart + duration.value(30, "d")
              )
              || (
                resource.data.keys().hasAny(["displayNameChangeWindowStart"])
                && request.time < resource.data.displayNameChangeWindowStart + duration.value(30, "d")
                && resource.data.keys().hasAny(["displayNameChangesInWindow"])
                && request.resource.data.displayNameChangesInWindow == resource.data.displayNameChangesInWindow + 1
                && request.resource.data.displayNameChangesInWindow <= 3
                && request.resource.data.displayNameChangeWindowStart == resource.data.displayNameChangeWindowStart
              )
          )
        );

      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if hasAdminPermission("editProfiles") && request.resource.data.uid == resource.data.uid;
      allow update: if hasAdminPermission("manageBans") && request.resource.data.uid == resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["moderation","updatedAt"]);
    }

    match /appUpdates/{releaseId} {
      // Release metadata is intentionally public so update checks can run
      // before authentication/profile setup.
      allow read: if true;
      allow create, update, delete: if hasAdminPermission("manageUpdates");
    }

    match /adminRoles/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if isRootAdmin() || (hasAdminPermission("manageAdminRoles") && uid != request.auth.uid);
    }

    match /cosmeticRoles/{roleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if hasAdminPermission("manageCosmetics");
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.recipientId is string
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.body is string;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    match /communityServers/{serverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.moderation.serverCreationDisabled
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ["OWNER", "MEMBER"]
          && (request.resource.data.role == "MEMBER"
            || get(/databases/$(database)/documents/communityServers/$(serverId)).data.ownerId == request.auth.uid);
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/communityServers/$(serverId)).data.ownerId == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
          && request.resource.data.role in ["ADMIN", "MEMBER"];
        allow delete: if request.auth != null
          && (uid == request.auth.uid
            || get(/databases/$(database)/documents/communityServers/$(serverId)).data.ownerId == request.auth.uid);
      }

      match /categories/{categoryId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/communityServers/$(serverId)).data.ownerId == request.auth.uid;
      }

      match /channels/{channelId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/communityServers/$(serverId)).data.ownerId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.moderation.storyDisabled
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType is string
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <= request.resource.data.createdAt + 86400000;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likesCount", "commentsCount"])
        && request.resource.data.likesCount is number
        && request.resource.data.likesCount >= 0;
      
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && uid == request.auth.uid;
        allow update: if false;
      }
    }
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.moderation.postingDisabled
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorUsername is string
        && request.resource.data.authorPhotoUrl is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType is string
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10
        && request.resource.data.likesCount == 0
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likesCount"])
        && request.resource.data.likesCount is number
        && request.resource.data.likesCount >= 0
        && request.resource.data.likesCount <= 1000000
        && request.resource.data.commentsCount is number
        && request.resource.data.commentsCount >= 0
        && request.resource.data.commentsCount <= 1000000;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && uid == request.auth.uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.moderation.commentingDisabled
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is number;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    match /savedPosts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.savedAt is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;

      match /posts/{postId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }


  }
}
